# Ghost Protocol backend environment contract (Phase 2)
# Copy to backend/.env for local use. Never commit real secrets.
#
# Railway production injects PORT and should inject DATABASE_URL via
# service variables (for example ${{Postgres.DATABASE_URL}}).
# Never put DATABASE_URL in Vercel/Electron/VITE_/NEXT_PUBLIC_ variables.

# ---------------------------------------------------------------------------
# Local development example
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Placeholder only — replace for local Postgres. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# TLS to PostgreSQL (local):
# - disable for typical local Postgres without TLS
DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# Railway / production guidance (set in Railway dashboard, not in Git)
# ---------------------------------------------------------------------------
# NODE_ENV=production
# PORT=<injected by Railway>
# DATABASE_URL=<Railway private Postgres URL via service variable reference>
# DATABASE_SSL=require
# Prefer keeping certificate validation enabled:
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional: path to a CA bundle if Railway/your provider supplies one
# DATABASE_SSL_CA=/path/to/ca.pem
#
# Only set the following if you have documented why validation must be relaxed
# (for example temporary self-signed proxy constraints). This weakens MITM
# protection and is not the default:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Browser / Electron origins allowed to call the API in production CORS (Phase 3+)
FRONTEND_URL=http://localhost:5173

# Public base URL of this API (used in docs/redirects later; not a DB URL)
API_PUBLIC_URL=http://localhost:3000

# Signing secrets for short-lived access credentials and refresh/session tokens
# Unused until Phase 3. Replace with long, random values before authentication work.
ACCESS_TOKEN_SECRET=replace-with-long-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-long-random-refresh-secret
