# Ghost Protocol backend environment contract (Phase 2)
# Copy to backend/.env for local use. Never commit real secrets.
#
# Authentication token variable names assume a future first-party
# access + refresh/session design (Phase 3+). They are unused in Phase 2.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (server-side only; never ship to clients)
DATABASE_URL=postgresql://ghost_app:CHANGE_ME@127.0.0.1:5432/ghost_protocol

# TLS to PostgreSQL:
# - unset: SSL enabled automatically when NODE_ENV=production
# - require|true: force SSL
# - disable|false: disable SSL (local development)
DATABASE_SSL=disable
# Set to false only if your hosted provider requires it (document why)
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Browser / Electron origins allowed to call the API in production CORS (Phase 3+)
FRONTEND_URL=http://localhost:5173

# Public base URL of this API (used in docs, redirects, and client config later)
API_PUBLIC_URL=http://localhost:3000

# Signing secrets for short-lived access credentials and refresh/session tokens
# Unused until Phase 3. Replace with long, random values before authentication work.
ACCESS_TOKEN_SECRET=replace-with-long-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-long-random-refresh-secret
