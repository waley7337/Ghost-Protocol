# Ghost Protocol backend environment contract (Phase 1)
# Copy to backend/.env for local use. Never commit real secrets.
#
# Authentication token variable names below assume a first-party
# access + refresh/session design. If the final auth design changes
# (for example cookie-only sessions or a different secret split),
# update this file to match — do not invent unused secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (server-side only; never ship to clients)
DATABASE_URL=postgresql://ghost_app:CHANGE_ME@127.0.0.1:5432/ghost_protocol

# Browser / Electron origins allowed to call the API in production CORS
FRONTEND_URL=http://localhost:5173

# Public base URL of this API (used in docs, redirects, and client config)
API_PUBLIC_URL=http://localhost:3000

# Signing secrets for short-lived access credentials and refresh/session tokens
# Replace with long, random values before any real authentication work.
ACCESS_TOKEN_SECRET=replace-with-long-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-long-random-refresh-secret
