# Ghost Protocol backend environment contract (Phase 3)
# Copy to backend/.env for local use. Never commit real secrets.
#
# Railway production injects PORT and should inject DATABASE_URL via
# service variables (for example ${{Postgres.DATABASE_URL}}).
# Never put DATABASE_URL in Vercel/Electron/VITE_/NEXT_PUBLIC_ variables.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Placeholder only — replace for local Postgres. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# TLS to PostgreSQL (local):
DATABASE_SSL=disable

# Authentication secrets (required for /auth/* and for production startup)
# Use long, random values. Never commit real secrets.
ACCESS_TOKEN_SECRET=replace-with-long-random-access-secret-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-long-random-refresh-secret-at-least-32-chars

# JWT claims
JWT_ISSUER=ghost-protocol-api
JWT_AUDIENCE=ghost-protocol-clients

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Auth endpoint rate limit (in-process foundation)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Only enable if the process sits behind a trusted reverse proxy / Cloudflare
TRUST_PROXY=false

JSON_BODY_LIMIT_BYTES=16384

# Browser / Electron origins allowed to call the API in production CORS (later)
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Railway / production guidance (set in Railway dashboard, not in Git)
# ---------------------------------------------------------------------------
# NODE_ENV=production
# PORT=<injected by Railway>
# DATABASE_URL=<Railway private Postgres URL via service variable reference>
# ACCESS_TOKEN_SECRET=<long random>
# REFRESH_TOKEN_SECRET=<long random>
# DATABASE_SSL=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
